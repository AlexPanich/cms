# Продакшен (docker-compose.prod.yml): скопируйте в .env на сервере и заполните.

# Домен сайта: на него Caddy получит сертификат, адрес сайта — https://SITE_DOMAIN.
SITE_DOMAIN=example.com

# Пароль БД попадает в DATABASE_URL, поэтому без спецсимволов: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_USER=cms
POSTGRES_DB=cms

# Подпись cookie сессий: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Резервные копии: каталог на сервере, как часто и сколько дней хранить.
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14
